@online{NN.cv,
author    = {plante},
url       = {https://ctan.org/pkg/eoldef},
urldate   = {2026-07-14},
title     = {eoldef},
subtitle  = {Define commands which absorb the whole source line as arguments}, 
version   = {1.1},
userc     = {https://ctan.org/tex-archive/macros/generic/eoldef},
abstract  = {(no language specified) This macro allows you to define commands that take the entire source line as arguments.

            Usage: 
            \begin{verbatim}\eoldef &lt;control sequence&gt; &lt;parameter
text&gt; { &lt;replacement text&gt;}            \end{verbatim}
defines a control sequence that is delimited by the end-of-line in addition to the specified parameter text.

            For instance,  \verb|\eoldef\test#1:#2{}| and

            \verb|\test abc:def| 

            will give  \verb|#1| = \verb|abc| , \verb|#2| = \verb|def| .

            \verb|\eolgdef| is the \verb|\global| variant to \verb|\eoldef| .

            Like  \verb|\verb|…|| , \verb|\eoldef| ’d commands may generally not be used as part of another command’s argument as it changes catcodes. However, if you must use it in environments where catcodes are frozen, you may follow the command with a braced argument, eg. \verb|\test{#1:#2}| using the previous example.

            This package may be used in plain TeX or LaTeX by  \verb|\input{eoldef}| .},
language  = {no language specified},
keywords  = {etex; macro-def},
userb     = {lppl1.3c (free)},
related   = {Olsak.f},
note      = {Documentation (no language specified): Readme: https://ctan.org/tex-archive/macros/generic/eoldef/README.md;
            on MikTeX: eoldef;
            on TeXLive: eoldef},
}

