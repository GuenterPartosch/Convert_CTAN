@online{Lyu2025.b,
author    = {Lyu, Jianrui},
url       = {https://ctan.org/pkg/tabularray},
urldate   = {2026-07-14},
title     = {tabularray},
subtitle  = {Typeset tabulars and arrays with LaTeX3}, 
version   = {2025C (2025-11-27)},
date      = {2025-11-27},
year      = {2025},
userc     = {https://ctan.org/tex-archive/macros/latex/contrib/tabularray},
abstract  = {(no language specified) LaTeX tables are implemented using TeX commands such as  \texttt{{\textbackslash}halign} , \texttt{{\textbackslash}noalign} , \texttt{{\textbackslash}span} , 
            and \texttt{{\textbackslash}omit} . In order to implement new features, many macro 
            packages have modified the inner table commands inside LaTeX. This makes package code complicated, difficult 
            to maintain, and often conflicts with each other.

            At present, the LaTeX3 programming layer is basically mature. This  \texttt{tabularray} package 
            will discard the old \texttt{{\textbackslash}halign} commands and directly use LaTeX3 
